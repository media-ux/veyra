# ---------------------------------------------------------------------------
# Copy this file to ".env" and paste your real keys there.
# The ".env" file is git-ignored and is read ONLY by the Node/Express backend.
# The browser never sees these values.
# ---------------------------------------------------------------------------

# Manatal (your ATS / candidate source)
MANATAL_API_KEY=your_manatal_api_key_here

# DeepSeek (writes the outreach messages and classifies replies)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Login gate. If APP_PASSWORD is set, the app requires sign-in and the API
# rejects requests without a valid token. Leave APP_PASSWORD empty to disable
# login (e.g. local dev). Username defaults to "admin" if not set.
APP_USERNAME=admin
APP_PASSWORD=

# Optional: override the backend port (defaults to 5174)
PORT=5174
